#!/usr/bin/env bash
set -euo pipefail

cd "$(dirname "${BASH_SOURCE[0]}")/.."

bundle exec rake
bundle exec ruby examples/dialogue.rb

# 只检查小规模工作负载的正确性，不为共享 CI 机器设置性能阈值。
for benchmark in matching relay send_slow scaling redactor; do
  bundle exec ruby "benchmark/${benchmark}.rb" --smoke
done

mkdir -p tmp/ci
gem_version="$(ruby -Ilib -rexpect/version -e 'print Expect::VERSION')"
gem_file="tmp/ci/expect-pty-${gem_version}.gem"
if git rev-parse --git-dir >/dev/null 2>&1; then
  export SOURCE_DATE_EPOCH="$(git log -1 --format=%ct)"
fi
gem build expect-pty.gemspec --output "$gem_file"

# 在独立目录安装刚构建的包，避免源码路径或 Bundler 掩盖打包遗漏。
smoke_dir="$(mktemp -d)"
trap 'rm -rf "$smoke_dir"' EXIT
gem_file="$(pwd)/$gem_file"
bundler_version="$(bundle exec ruby -rbundler -e 'print Bundler::VERSION')"
bundler_gem="$(bundle exec ruby -e 'print Gem.loaded_specs.fetch("bundler").cache_file')"

# 独立安装可用本次解析的运行依赖缓存；Ruby 4 的 Logger 不再是默认 gem。
# 只复制实际运行依赖，不让开发依赖或宿主 GEM_PATH 掩盖安装遗漏。
bundle exec ruby -Ilib -rexpect -rfileutils -e '
  Gem.loaded_specs.fetch("expect-pty").runtime_dependencies.each do |dependency|
    spec = Gem.loaded_specs.fetch(dependency.name)
    next if spec.default_gem?

    FileUtils.cp(spec.cache_file, ARGV.fetch(0))
  end
' "$smoke_dir"

(
  cd "$smoke_dir"
  # 清除 Bundler 的自动加载与路径设置；Ruby 4 还会通过 BUNDLER_SETUP 自动启用 Bundler。
  for bundle_variable in ${!BUNDLE_@} ${!BUNDLER_@}; do
    unset "$bundle_variable"
  done
  unset RUBYOPT RUBYLIB RUBYGEMS_GEMDEPS
  export GEM_HOME="$smoke_dir/gems" GEM_PATH="$smoke_dir/gems"
  gem install --local --no-document "$gem_file"

  cat > smoke.rb <<'RUBY'
require "expect/pty"
require "rbconfig"

spec = Gem.loaded_specs.fetch("expect-pty")
# 临时目录可能经由符号链接访问，先统一为实际路径再检查。
install_root = File.realpath(ENV.fetch("GEM_HOME"))
abort "gem was loaded outside the isolated install" unless File.realpath(spec.full_gem_path).start_with?("#{install_root}/")
abort "Bundler leaked into the plain gem smoke" if ARGV.first == "plain" && defined?(Bundler)
unexpected = %w[minitest rake rubocop parallel rbs yard].select { |name| Gem.loaded_specs.key?(name) }
abort "development dependencies leaked into the application: #{unexpected.join(', ')}" unless unexpected.empty?
abort "installed RBS missing" unless File.file?(File.join(spec.full_gem_path, "sig/expect.rbs"))
forbidden = spec.files.grep(%r{\A(?:test/|benchmark/|examples/|script/|Gemfile|Rakefile|\.rubocop)})
abort "development files leaked into gem: #{forbidden.join(', ')}" unless forbidden.empty?
spec.runtime_dependencies.each do |dependency|
  loaded = Gem.loaded_specs.fetch(dependency.name)
  abort "incompatible dependency: #{dependency}" unless dependency.matches_spec?(loaded)
end

# 检查实际使用的标准库已在包元数据中声明，默认 gem 可加载不能代替依赖声明。
%w[io-console logger stringio].each do |name|
  abort "undeclared runtime dependency: #{name}" unless spec.runtime_dependencies.any? { |dependency| dependency.name == name }
end
child = 'STDOUT.sync = true; puts "ready"; puts "reply:#{$stdin.gets&.strip}"'
Expect.spawn(RbConfig.ruby, "--disable-gems", "-e", child, raw: true) do |session|
  session.to_io.winsize = [30, 100]
  abort "io-console terminal size failed" unless session.to_io.winsize == [30, 100]
  # 先收取提示，使子进程停在等待输入的位置。
  abort "installed gem did not receive the PTY prompt" unless session.expect("ready", timeout: 5).matched?
  mode = session.to_io.console_mode
  session.to_io.console_mode = mode

  session.puts("expect-ruby")
  abort "installed gem PTY dialogue failed" unless session.expect("reply:expect-ruby", timeout: 5).matched?
  status = session.soft_close(timeout: 5)
  abort "installed gem child did not exit successfully" unless status&.success?
end

# 使用已安装包验证公共过滤器随包分发，且结构化诊断使用标准 Logger。
filter = Expect::Redactor.new(["secret"], replacement: "[REDACTED]")
filtered = filter.append("sec") + filter.append("ret!") + filter.finish
abort "installed public redactor failed" unless filtered == "[REDACTED]!"
abort "installed complete-text redactor failed" unless Expect::Redactor.redact("sec", ["secret"]) == "sec"
reader, producer = IO.pipe
events = []
transcript = StringIO.new
logger = Logger.new(StringIO.new, level: Logger::DEBUG)
logger.formatter = lambda do |_severity, _time, _name, event|
  events << event
  ""
end
begin
  Expect.open(reader, own: true, buffer_limit: 5, logger:, transcript:) do |session|
    session.redact("secret")
    session.buffer = "ready"
    expired = session.expect("ready", deadline: Expect.monotonic)
    abort "expired deadline consumed buffered text" unless expired.timeout? && session.buffer == "ready"
    abort "zero timeout lost buffered text" unless session.expect("ready", timeout: 0).number == 1
    producer.write("secret!")
    producer.close
    result = session.expect(:eof, deadline: Expect.monotonic + 5)
    abort "installed gem did not preserve capped input" unless result.eof? && result.before == "cret!"
    abort "incorrect installed buffer accounting" unless session.buffer_discarded_bytes == 2
    abort "installed redaction failed" unless transcript.string == "[FILTERED]!"
    abort "diagnostics leaked secret" if events.any? { |event| event[:message].include?("secret") }
    abort "filtered diagnostic missing" unless events.any? { |event| event[:message].include?("[FILTERED]") }
  end
ensure
  reader.close unless reader.closed?
  producer.close unless producer.closed?
end

puts "Installed #{spec.full_name}: #{ARGV.fetch(0)} PTY, core contracts and runtime dependencies passed"
RUBY
  ruby smoke.rb plain

  # 消费方仅声明当前 Gem，不能借用项目 Gemfile 中的测试和发布依赖。
  # 单独安装本次开发检查使用的 Bundler，避免依赖宿主 Ruby 的默认 Bundler 副本。
  if [ -f "$bundler_gem" ]; then
    gem install --local --no-document "$bundler_gem"
  else
    gem install --no-document bundler --version "$bundler_version"
  fi
  export BUNDLE_IGNORE_CONFIG=true
  printf 'source "https://rubygems.org"\ngem "expect-pty", "= %s", require: "expect/pty"\n' "$gem_version" > Gemfile
  bundle lock --local
  bundle exec ruby -rbundler -e 'Bundler.require; load "smoke.rb"' bundler
)
